# Your Postgres database (any host). Add ?sslmode=require for a remote server.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Signs login tokens. Long random string, at least 32 characters. Generate with:
#   openssl rand -base64 48
# Changing it signs everybody out.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Database pool size. Keep 1 behind a connection pooler (PgBouncer);
# on a direct Postgres connection 10 is a good value.
DB_MAX_CONNS=10

PORT=8080

# Demo data simulator: simulated live values for every machine (default true).
# Set to false once the OPC UA edge gateway (gateway/) is approved and live.
SIMULATOR_ENABLED=true

# Built-in demo OPC UA connection (no gateway): machine codes, comma-separated,
# whose metrics are read live from OPCUA_ENDPOINT. Empty = off.
OPCUA_ENDPOINT=opc.tcp://146.196.46.162:4840/abhipsita/abexon
OPCUA_DEMO_MACHINES=
